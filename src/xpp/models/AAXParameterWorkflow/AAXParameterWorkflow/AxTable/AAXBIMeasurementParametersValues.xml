				<Source><![CDATA[
    static AAXBIMeasurementParametersValues find(RecId _AAXSystemParametersVersionRecId, boolean _forUpdate = false)
    {

        AAXBIMeasurementParametersValues param;
        param.selectForUpdate(_forUpdate);

        select firstonly param
        where param.AAXSystemParametersVersion == _AAXSystemParametersVersionRecId;

        if (!param)
