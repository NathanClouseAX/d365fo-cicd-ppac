				<Name>createDefault</Name>
				<Source><![CDATA[
    public static void createDefault(RecId _AAXSystemParametersVersionRecId)
    {
        AAXEventSystemParametersValues AAXEventSystemParametersValues;
        EventSystemParameters EventSystemParameters;

        if(!AAXSystemParametersValues::exists(_AAXSystemParametersVersionRecId))
        {
            EventSystemParameters = EventSystemParameters::find();

            AAXEventSystemParametersValues.AlertTemplateId = EventSystemParameters.AlertTemplateId;
            AAXEventSystemParametersValues.DrillDownGroupId = EventSystemParameters.DrillDownGroupId;
            AAXEventSystemParametersValues.MaxDays = EventSystemParameters.MaxDays;
            AAXEventSystemParametersValues.insert();
        }
    }

]]></Source>
