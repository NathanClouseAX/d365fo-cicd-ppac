				<Source><![CDATA[
    /// <summary>
    ///    Finds a record in the <c>SystemParameters</c> table.
    /// </summary>
    /// <param name="_forUpdate">
    ///    A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    ///    A record in the <c>SystemParameters</c> table.
    /// </returns>
    /// <remarks>
    ///    This method inserts a new record into the <c>SystemParameters</c> table if one does not exist.
    /// </remarks>
    public static AAXSystemParametersValues find(RecId _AAXSystemParametersVersionRecId, boolean _forUpdate = false)
    {
        AAXSystemParametersValues    AAXSystemParametersValues;

        AAXSystemParametersValues.selectForUpdate(_forUpdate);

        select firstonly AAXSystemParametersValues
            where AAXSystemParametersValues.AAXSystemParametersVersion == _AAXSystemParametersVersionRecId;

        return AAXSystemParametersValues;
    }

]]></Source>
			</Method>
			<Method>
				<Name>createDefault</Name>
				<Source><![CDATA[
    /// <summary>
    /// Snapshots current SystemParameters values into a version value record. Uses
    /// AAXParameterUtil::copyFromParameterToVersion for bulk field copy by name, then
    /// manually sets the user timeout which comes from SecurityConfigProvider rather
    /// than a table field. Idempotent: skips if a value record already exists for this version.
    /// </summary>
    /// <param name = "_AAXSystemParametersVersionRecId">RecId of the parent version</param>
    public static void createDefault(RecId _AAXSystemParametersVersionRecId)
    {
        const int MillisecondsPerSecond = 1000;

        AAXSystemParametersValues AAXSystemParametersValues;
        SystemParameters systemParameters;

        if(!AAXSystemParametersValues::exists(_AAXSystemParametersVersionRecId))
        {
            systemParameters = SystemParameters::find();

            AAXSystemParametersValues.AAXSystemParametersVersion = AAXSystemParametersVersion::find(_AAXSystemParametersVersionRecId).RecId;

            // Bulk copy matching fields from SystemParameters to the version value record
            AAXSystemParametersValues = AAXParameterUtil::copyFromParameterToVersion(systemParameters, AAXSystemParametersValues);

            // User timeout is stored in SecurityConfigProvider, not on the SystemParameters table
            AAXSystemParametersValues.userTimeoutInSeconds = SecurityConfigProvider::getListUsersWaitTimeInMilliseconds() / MillisecondsPerSecond;

            AAXSystemParametersValues.insert();
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>exists</Name>
				<Source><![CDATA[
    /// <summary>
    /// check if a record exists
    /// </summary>
    /// <param name = "_AAXSystemParametersVersionRecId">RecId</param>
    /// <returns>boolean</returns>
    public static boolean exists(RecId _AAXSystemParametersVersionRecId)
    {
        return AAXSystemParametersValues::find(_AAXSystemParametersVersionRecId).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateField</Name>
				<Source><![CDATA[
    /// <summary>
    /// validates the fields of the <c>AAXSystemParametersValues</c> table
    /// </summary>
    /// <param name = "_fieldIdToCheck">FieldId</param>
    /// <returns>boolean</returns>
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret;
    
        ret = super(_fieldIdToCheck);

        switch(_fieldIdToCheck)
        {
            case fieldNum(AAXSystemParametersValues, userTimeoutInSeconds):
                int valueInSeconds = this.userTimeoutInSeconds;

                int minValueInSeconds = Microsoft.Dynamics.AX.Security.SharedUtility.SecurityConfigHelper::ListUsersWaitTimeInMillisecondsMinimumValue / 1000;
                int maxValueInSeconds = Microsoft.Dynamics.AX.Security.SharedUtility.SecurityConfigHelper::ListUsersWaitTimeInMillisecondsMaximumValue / 1000;

                boolean isValid = valueInSeconds >= minValueInSeconds && valueInSeconds <= maxValueInSeconds;

                if (!isValid)
                {
                    warning(strFmt("@Security:ListUsersWaitTimeOverrideWarning", minValueInSeconds, maxValueInSeconds));
                }

                ret = ret && isValid;
                break;
            // Add custom field validations here if needed
            default:
                ;
        }
    
        return ret;
    }

]]></Source>
