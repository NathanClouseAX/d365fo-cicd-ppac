		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static AAXSystemNotificationParametersValues find(RecId _AAXSystemParametersVersionRecId, boolean _forUpdate = false)
    {
        AAXSystemNotificationParametersValues param;
        param.selectForUpdate(_forUpdate);

        select firstonly param
        where param.AAXSystemParametersVersion == _AAXSystemParametersVersionRecId;

        if (!param)
        {
            Company::createParameter(param);
        }

        return param;
    }

]]></Source>
			</Method>
			<Method>
				<Name>createDefault</Name>
				<Source><![CDATA[
    /// <summary>
    /// Snapshots current SystemNotificationParameters values (threshold settings and
    /// retention period) into a version value record. Idempotent: skips if already exists.
    /// </summary>
    /// <param name = "_AAXSystemParametersVersionRecId">RecId of the parent version</param>
    public static void createDefault(RecId _AAXSystemParametersVersionRecId)
    {
        AAXSystemNotificationParametersValues AAXSystemNotificationParametersValues;
        SystemNotificationParameters SystemNotificationParameters;

        if(!AAXSystemNotificationParametersValues::exists(_AAXSystemParametersVersionRecId))
        {
            SystemNotificationParameters = SystemNotificationParameters::find();

            AAXSystemNotificationParametersValues.ActiveNotificationThresholdDefault = SystemNotificationParameters.ActiveNotificationThresholdDefault;
            AAXSystemNotificationParametersValues.ThresholdEvaluationPeriodDefault = SystemNotificationParameters.ThresholdEvaluationPeriodDefault;
            AAXSystemNotificationParametersValues.ThresholdHistoryRetentionPeriod = SystemNotificationParameters.ThresholdHistoryRetentionPeriod;
            AAXSystemNotificationParametersValues.insert();
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>exists</Name>
				<Source><![CDATA[
    public static boolean exists(RecId _AAXSystemParametersVersionRecId)
    {
        return AAXSystemNotificationParametersValues::find(_AAXSystemParametersVersionRecId).RecId != 0;
    }

]]></Source>
			</Method>
