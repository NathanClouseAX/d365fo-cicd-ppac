		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///    Finds a record in the <c>FileUploadConfiguration</c> table.
    /// </summary>
    /// <param name="_forUpdate">
    ///    A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    ///    A record in the <c>FileUploadConfiguration</c> table.
    /// </returns>
    /// <remarks>
    ///    This method inserts a new record into the <c>FileUploadConfiguration</c> table if one does not exist.
    /// </remarks>
    public static AAXFileUploadConfigurationValues find(RecId _AAXSystemParametersVersionRecId, boolean _forUpdate = false)
    {
        AAXFileUploadConfigurationValues fileUploadConfiguration;

        fileUploadConfiguration.selectForUpdate(_forUpdate);

        select firstonly fileUploadConfiguration
            where fileUploadConfiguration.AAXSystemParametersVersion == _AAXSystemParametersVersionRecId;

        return fileUploadConfiguration;
    }

]]></Source>
			</Method>
			<Method>
				<Name>createDefault</Name>
				<Source><![CDATA[
    /// <summary>
    /// Snapshots current FileUploadConfiguration values (blob link expiration, bundle limits,
    /// scan intervals) into a version value record. Idempotent: skips if already exists.
    /// </summary>
    /// <param name = "_AAXSystemParametersVersionRecId">RecId of the parent version</param>
    public static void createDefault(RecId _AAXSystemParametersVersionRecId)
    {
        AAXFileUploadConfigurationValues AAXFileUploadConfigurationValues;
        FileUploadConfiguration FileUploadConfiguration;

        if(!AAXSystemParametersValues::exists(_AAXSystemParametersVersionRecId))
        {
            FileUploadConfiguration = FileUploadConfiguration::find();

            AAXFileUploadConfigurationValues.AAXSystemParametersVersion = _AAXSystemParametersVersionRecId;
            AAXFileUploadConfigurationValues.File_BlobLinkExpirationTimeSpanInMinutes = FileUploadConfiguration.File_BlobLinkExpirationTimeSpanInMinutes;
            AAXFileUploadConfigurationValues.Image_BlobLinkExpirationTimeSpanInMinutes = FileUploadConfiguration.Image_BlobLinkExpirationTimeSpanInMinutes;
            AAXFileUploadConfigurationValues.Video_BlobLinkExpirationTimeSpanInMinutes = FileUploadConfiguration.Video_BlobLinkExpirationTimeSpanInMinutes;
            AAXFileUploadConfigurationValues.MaxFilesPerBundle = FileUploadConfiguration.MaxFilesPerBundle;
            AAXFileUploadConfigurationValues.MaxBundleCount = FileUploadConfiguration.MaxBundleCount;
            AAXFileUploadConfigurationValues.FileExpirationScanIntervalInHours = FileUploadConfiguration.FileExpirationScanIntervalInHours;

            AAXFileUploadConfigurationValues.insert();
        }
    }

]]></Source>
			</Method>
