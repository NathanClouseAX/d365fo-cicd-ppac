    /// <summary>
    /// Initializes the compare dialog by building a diff between the selected version
    /// and the current live parameters, then binding the results to the temp table
    /// data source for display in the grid.
    /// </summary>
    public void init()
    {
        super();

        // Factory creates the correct comparison subclass based on the caller's record type
        AAXParameterCompare AAXParameterCompare = AAXParameterCompare::constuct(element.args().record());

        // Bind the populated temp table data to the form's data source
        AAXtmpParameterCompare.setTmpData(AAXParameterCompare.GetData());
    }

