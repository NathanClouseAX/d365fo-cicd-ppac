			<Method>
				<Name>createDefault</Name>
				<Source><![CDATA[
    /// <summary>
    /// Snapshots the BatchGlobal SingleScheduler entry values into a version value record.
    /// Uses the same lookup pattern as BatchRunSingleScheduler to find the correct row.
    /// Idempotent: skips if already exists.
    /// </summary>
    /// <param name = "_AAXSystemParametersVersionRecId">RecId of the parent version</param>
    public static void createDefault(RecId _AAXSystemParametersVersionRecId)
    {
        AAXBatchGlobalValues AAXBatchGlobalValues;
        BatchGlobal BatchGlobalValues;

        // Match the lookup used by BatchRunSingleScheduler.getSingleSchedulerBatchGlobalEntry
        str SingleScheduler = "SingleScheduler";
        select firstonly pessimisticlock * from BatchGlobalValues where BatchGlobalValues.Name == SingleScheduler;

        if(!AAXBatchGlobalValues::exists(_AAXSystemParametersVersionRecId))
        {
            AAXBatchGlobalValues.Name = BatchGlobalValues.Name;
            AAXBatchGlobalValues.ServerId = BatchGlobalValues.ServerId;
            AAXBatchGlobalValues.SessionIdx = BatchGlobalValues.SessionIdx;
            AAXBatchGlobalValues.LastProcFinishedJobs = BatchGlobalValues.LastProcFinishedJobs;
            AAXBatchGlobalValues.AAXSystemParametersVersion = _AAXSystemParametersVersionRecId;
            AAXBatchGlobalValues.BatchReservedCapacityLevel = BatchGlobalValues.BatchReservedCapacityLevel;
            AAXBatchGlobalValues.insert();
        }
    }

]]></Source>
			</Method>
