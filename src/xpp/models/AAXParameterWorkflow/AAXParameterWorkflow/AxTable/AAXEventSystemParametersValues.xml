				<Source><![CDATA[
    /// <summary>
    ///    Finds a record in the <c>EventSystemParameters</c> table.
    /// </summary>
    /// <param name="_forUpdate">
    ///    A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    ///    A record in the <c>EventSystemParameters</c> table.
    /// </returns>
    /// <remarks>
    ///    This method inserts a new record into the <c>EventSystemParameters</c> table if it does not exist
    ///    and then returns it.
    /// </remarks>
    public client server static AAXEventSystemParametersValues find(RecId _AAXSystemParametersVersionRecId, boolean _forUpdate = false)
    {
        AAXEventSystemParametersValues   eventSystemParameters;

        eventSystemParameters.selectForUpdate(_forUpdate);

        select firstonly eventSystemParameters
            where eventSystemParameters.AAXSystemParametersVersion == _AAXSystemParametersVersionRecId;

        return eventSystemParameters;
    }

]]></Source>
