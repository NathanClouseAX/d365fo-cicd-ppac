		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
     public static AAXDataFeedsParametersValues find(RecId _AAXSystemParametersVersionRecId, boolean _forUpdate = false)
    {
        AAXDataFeedsParametersValues parameters;

        parameters.selectForUpdate(_forUpdate);

        select firstonly parameters
            where parameters.AAXSystemParametersVersion == _AAXSystemParametersVersionRecId;

        if (!parameters)
        {
            Company::createParameter(parameters);
        }

        return parameters;
    }

]]></Source>
			</Method>
			<Method>
				<Name>createDefault</Name>
				<Source><![CDATA[
    public static void createDefault(RecId _AAXSystemParametersVersionRecId)
    {                      
        AAXDataFeedsParametersValues AAXDataFeedsParametersValues;
        DataFeedsParameters DataFeedsParameters;

        if(!AAXSystemParametersValues::exists(_AAXSystemParametersVersionRecId))
        {
            DataFeedsParameters = DataFeedsParameters::find();

            AAXDataFeedsParametersValues.AAXSystemParametersVersion = _AAXSystemParametersVersionRecId;
            AAXDataFeedsParametersValues.BundleSize = DataFeedsParameters.BundleSize;
            AAXDataFeedsParametersValues.Enabled = DataFeedsParameters.Enabled;
            AAXDataFeedsParametersValues.ThreadCount = DataFeedsParameters.ThreadCount;
            AAXDataFeedsParametersValues.insert();

        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>exists</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public static boolean exists(RecId _AAXSystemParametersVersionRecId)
    {                  
        return AAXDataFeedsParametersValues::find(_AAXSystemParametersVersionRecId).RecId != 0;
    }

]]></Source>
