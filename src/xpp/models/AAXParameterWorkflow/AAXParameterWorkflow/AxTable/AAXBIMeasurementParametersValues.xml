				<Source><![CDATA[
    public static void createDefault(RecId _AAXSystemParametersVersionRecId)
    {
        AAXBIMeasurementParametersValues AAXBIMeasurementParametersValues;
        BIMeasurementParameters BIMeasurementParameters;

        if(!AAXBIMeasurementParametersValues::exists(_AAXSystemParametersVersionRecId))
        {
            BIMeasurementParameters = BIMeasurementParameters::find();

            AAXBIMeasurementParametersValues.AAXSystemParametersVersion = _AAXSystemParametersVersionRecId;
            AAXBIMeasurementParametersValues.AzureAppId = BIMeasurementParameters.AzureAppId;
            AAXBIMeasurementParametersValues.AzureAppSecret = BIMeasurementParameters.AzureAppSecret;
            AAXBIMeasurementParametersValues.CDSAEnabled = BIMeasurementParameters.CDSAEnabled;
            AAXBIMeasurementParametersValues.IncrementalEnabled = BIMeasurementParameters.IncrementalEnabled;
            AAXBIMeasurementParametersValues.KeyVaultDnsName = BIMeasurementParameters.KeyVaultDnsName;
            AAXBIMeasurementParametersValues.KeyVaultSecretName = BIMeasurementParameters.KeyVaultSecretName;
            AAXBIMeasurementParametersValues.UseNewEntityStoreForm = BIMeasurementParameters.UseNewEntityStoreForm;
            AAXBIMeasurementParametersValues.insert();

        }
    }

]]></Source>
